<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <Version>1.1.0</Version>
    <PackageId>WebViewHostBridge</PackageId>
    <Authors>Serhii Khrolenko</Authors>
    <Description>Zero-dependency two-way bridge between a desktop shell (WinForms/WPF hosting WebView2 or CefSharp) and the web app it renders: typed request/reply and notifications in both directions, opening host windows from the page, unsaved-changes guard before the host closes, host detection by user agent.</Description>
    <PackageTags>webview2;cefsharp;winforms;wpf;blazor;hybrid;host;bridge;interop</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/penguinLifter/WebViewHostBridge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/penguinLifter/WebViewHostBridge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
